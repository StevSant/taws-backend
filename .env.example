# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | staging | production
APP_ENV=development

# Comma-separated list is NOT supported directly by pydantic-settings' default list
# parsing for env vars; provide a JSON array string instead, e.g.:
# CORS_ORIGINS=["http://localhost:4200","https://your-frontend.vercel.app"]
CORS_ORIGINS=["http://localhost:4200"]

# Locale used for LLM-generated content (signals/briefings/scenarios) when a caller
# doesn't supply one, e.g. "en", "es", "es-MX".
DEFAULT_LOCALE=en

# --- OpenAI (primary LLM provider, behind the LLMProvider port) ---
OPENAI_API_KEY=
# Fast/default tier (issue #28): chat routing, conversation titles, sentiment tone scoring,
# scenario intake extraction, news blurb localization — small structured calls.
OPENAI_MODEL=gpt-4o-mini
# Reasoning tier (issue #28): impact signals, pending-news batch analysis, scenario synthesis,
# causal chains, macro interpretation, watchlist briefings, and the 6 chat specialists.
# LEAVE EMPTY to fall back to OPENAI_MODEL — i.e. unset reproduces today's single-model
# behavior exactly. Set it (e.g. gpt-4o) to raise quality on the analytical calls only.
OPENAI_MODEL_REASONING=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- OpenAI Realtime voice agent (ephemeral session mint + server-side tool dispatch) ---
# Master switch; when false the /chat/realtime/* endpoints return 503.
OPENAI_REALTIME_ENABLED=false
# SEPARATE billed Realtime key. MAY be left unset to reuse OPENAI_API_KEY (DI falls back to it).
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=alloy
# TTL (seconds) of a minted ephemeral client secret (ek_*) before it expires.
OPENAI_REALTIME_TTL_SECONDS=600

# --- Text-to-Speech (voice playback of assistant replies, behind the TTSProvider port) ---
# Leaving TTS_API_KEY unset disables TTS: chat still works, POST /api/v1/chat/speak
# returns 503, and the frontend falls back to the browser's speech synthesis. Kept as its
# own key (not reusing OPENAI_API_KEY) so TTS can be enabled/billed independently.
TTS_ENABLED=false
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=nova
TTS_RESPONSE_FORMAT=mp3
TTS_MAX_INPUT_CHARS=4096       # Max characters per /speak request; caps per-request TTS cost

# --- Speech-to-Text (dictate a chat message by voice, behind the STTProvider port) ---
# Leaving STT_API_KEY unset disables STT: chat still works, POST /api/v1/chat/transcribe
# returns 503, and the frontend falls back to the browser's speech recognition. Kept as its
# own key (not reusing OPENAI_API_KEY) so STT can be enabled/billed independently.
STT_ENABLED=false
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=whisper-1
STT_MAX_AUDIO_BYTES=26214400   # Max audio bytes per /transcribe request (25 MiB, Whisper cap); leave STT_API_KEY unset to disable

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
# MUST be the service-role (secret) key, NOT the anon/publishable key — this backend
# is architected to bypass RLS by design (see migration 0001's rationale) and writes
# will fail with `42501` RLS violations if a low-privilege key is used instead.
# Dashboard: Project Settings -> API -> "service_role" secret. Never expose this key
# to a browser/frontend context (contrast with the frontend's `supabaseAnonKey`, which
# is correctly the LOW-privilege anon key).
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
# Retry-with-backoff around every Supabase*Repository client call (issue #7): only
# transient network failures (DNS blips, dropped connections) are retried, never
# application-level Postgrest errors (RLS violations, constraint errors, etc).
SUPABASE_RETRY_MAX_ATTEMPTS=2
SUPABASE_RETRY_BACKOFF_BASE_SECONDS=0.2

# --- Database (Supabase Postgres connection string, used by the pgvector adapter) ---
# Use the Supavisor SESSION POOLER connection string, NOT the direct connection
# (issue #35): the direct host `db.<project-ref>.supabase.co` resolves to IPv6 only and
# fails on IPv4-only networks (App Runner, most CI, many local setups). The session
# pooler is dual-stack and reachable over IPv4. Copy it from the Supabase dashboard:
# Project Settings -> Database -> Connection string -> "Session pooler". Its shape is
# `postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres`
# (host `aws-0-<region>.pooler.supabase.com`, user `postgres.<project-ref>`).
DATABASE_URL=

# --- Marketaux (news + entity sentiment enrichment, behind the NewsProvider port) ---
# Free key at https://www.marketaux.com/register (no billing details required).
# Leave empty to disable this source (the adapter then returns no items).
MARKETAUX_API_KEY=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
# Comma-separated article languages, e.g. en,es
MARKETAUX_LANGUAGES=en
MARKETAUX_TIMEOUT_SECONDS=10.0
# Pages fetched per call (free plan: 3 articles/request, 100 requests/day)
MARKETAUX_MAX_PAGES=3
# Circuit breaker (issue #9): after a 402/401 (quota exhausted/unauthorized), stop
# calling Marketaux for this many minutes instead of retrying every poll.
MARKETAUX_COOLDOWN_MINUTES=20
# Shorter cool-down used after a 429 (rate-limited) — likely to clear sooner.
MARKETAUX_RATE_LIMIT_COOLDOWN_MINUTES=5

# --- NewsAPI.org (news, behind the NewsProvider port) ---
# Free key at https://newsapi.org/register. Leave empty to skip this source.
NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2
# Query used when no instrument symbols are requested (general market news).
NEWSAPI_DEFAULT_QUERY=stocks OR crypto OR markets
# Circuit breaker: after a 401/426 (key/quota/plan issue) stop calling NewsAPI for this
# many minutes; a 429 (rate-limited) uses the shorter cool-down below (clears sooner).
NEWSAPI_COOLDOWN_MINUTES=20
NEWSAPI_RATE_LIMIT_COOLDOWN_MINUTES=5

# --- Finnhub (company-news, behind the NewsProvider port) ---
# Free key at https://finnhub.io/register. Leave empty to skip this source.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# --- RSS feeds (behind the NewsProvider port); no key required ---
# JSON array string, same convention as CORS_ORIGINS above.
RSS_FEED_URLS=["https://www.coindesk.com/arc/outboundfeeds/rss/","https://finance.yahoo.com/news/rssindex"]
RSS_FEED_TIMEOUT_SECONDS=10.0

# --- CoinGecko (crypto prices, behind the MarketDataProvider port); no key required ---
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Short-TTL in-process cache in front of get_price_series/get_last_price (issue #8),
# keyed by (coin_id, days)/coin_id — cuts redundant calls against the free-tier rate limit.
COINGECKO_CACHE_TTL_SECONDS=60.0
# Optional free "Demo" API key (https://www.coingecko.com/en/api/pricing -> Demo plan):
# lifts the keyless public rate limits (~30 calls/min, 10k/month). Leave empty for keyless.
COINGECKO_API_KEY=
# Circuit-breaker backoff (seconds): after a live CoinGecko failure (e.g. 429), serve
# fixtures for this long instead of re-hitting the API on every poll.
COINGECKO_COOLDOWN_SECONDS=300.0

# --- FRED (macro: rates, CPI; behind the MacroDataProvider port) ---
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html.
# Leave empty to serve fixture rates/CPI instead (no crash).
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_RATES_SERIES_ID=FEDFUNDS
FRED_CPI_SERIES_ID=CPIAUCSL
# Extra "Contexto de mercado" indicators (issue #58): daily FRED series (gold PM fixing USD/oz,
# WTI oil USD/bbl, 10Y Treasury constant-maturity yield %).
FRED_GOLD_SERIES_ID=GOLDPMGBD228NLBM
FRED_OIL_SERIES_ID=DCOILWTICO
FRED_TREASURY_10Y_SERIES_ID=DGS10
FRED_TIMEOUT_SECONDS=10.0
# History window (observations) for GET /api/v1/macro/series/{indicator}.
MACRO_SERIES_DEFAULT_DAYS=90
MACRO_SERIES_MAX_DAYS=365

# --- VIX (volatility regime, behind the MacroDataProvider port); via yfinance, no key needed ---
VIX_SYMBOL=^VIX
VIX_LOW_THRESHOLD=15.0
VIX_ELEVATED_THRESHOLD=20.0
VIX_HIGH_THRESHOLD=30.0

# --- Fixture macro fallback values (used when FRED_API_KEY is unset or a live call fails) ---
FIXTURE_MACRO_RATE=5.25
FIXTURE_MACRO_CPI=3.2
FIXTURE_MACRO_VIX=18.5
FIXTURE_MACRO_GOLD=2350.0
FIXTURE_MACRO_OIL=78.0
FIXTURE_MACRO_TREASURY_10Y=4.25

# --- alternative.me (Crypto Fear & Greed Index, behind the FearGreedProvider port); no key
# required. Free public API: https://alternative.me/crypto/fear-and-greed-index/ ---
ALTERNATIVE_ME_BASE_URL=https://api.alternative.me
ALTERNATIVE_ME_TIMEOUT_SECONDS=10.0

# --- Fixture Fear & Greed fallback values (used when alternative.me is unreachable) ---
FIXTURE_FEAR_GREED_VALUE=50
FIXTURE_FEAR_GREED_CLASSIFICATION=Neutral

# --- Sentiment Analyst tone bucketing thresholds (tone_score -> SentimentLabel) ---
SENTIMENT_BULLISH_THRESHOLD=0.15
SENTIMENT_BEARISH_THRESHOLD=-0.15

# --- SEC EDGAR "latest filings" feed (behind the NewsProvider port); no key required, but
# SEC requires a descriptive User-Agent identifying the requester on every request
# (https://www.sec.gov/os/webmaster-faq#developers) — replace with a real app/company name
# + contact email before deploying publicly. Set SEC_EDGAR_ENABLED=false to disable this
# source without removing the URL(s) below. ---
SEC_EDGAR_ENABLED=true
SEC_EDGAR_USER_AGENT=TAWS Hackathon research@taws.dev
# JSON array string, same convention as CORS_ORIGINS/RSS_FEED_URLS above.
SEC_EDGAR_FEED_URLS=["https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&type=8-K&company=&dateb=&owner=include&count=100&output=atom"]
SEC_EDGAR_FEED_TIMEOUT_SECONDS=10.0

# --- Fundamentals / earnings calendar (behind the FundamentalsProvider port); yfinance, no
# key required. "Upcoming earnings risk" flags earnings dates within this many days of now.
UPCOMING_EARNINGS_RISK_WINDOW_DAYS=7

# --- Analyst signal generation (HU1 acceptance criterion: "≥2 news sources with source +
# date attached to each signal") ---
MIN_DISTINCT_NEWS_SOURCES=2

# Bounded retry around the Analyst's structured-output classification call before it
# degrades to an honest "uncertain, analysis unavailable" fallback. Retries transient
# failures only (rate limit / timeout / malformed structured output); a missing API key
# is not retried. MAX_ATTEMPTS counts retries after the first try (2 => up to 3 calls);
# backoff is exponential (base * 2**(attempt-1)).
SIGNAL_CLASSIFICATION_RETRY_MAX_ATTEMPTS=2
SIGNAL_CLASSIFICATION_RETRY_BACKOFF_BASE_SECONDS=0.5

# --- Pending news pre-filter (skip unimportant items without an LLM call) ---
# Floor (0-1) below which a pending news item is skipped without an LLM call
# (analysis_status -> skipped, skip_reason -> gated_low_relevance). This gates the COMBINED
# relevance + materiality score below, not symbol-relevance alone.
NEWS_RELEVANCE_SKIP_THRESHOLD=0.35
# How the two components of that combined score are weighted (normalized by their sum, so
# only the ratio matters). Materiality is what lets a genuinely important article that never
# spells out a watchlist ticker still clear the gate.
NEWS_PREFILTER_RELEVANCE_WEIGHT=0.6
NEWS_PREFILTER_MATERIALITY_WEIGHT=0.4
# Relevance credited when an article is linked to an instrument by company/fund NAME rather
# than by its ticker ("Apple unveils..." -> AAPL). Weaker evidence than an explicit ticker,
# hence < 1.0 — but these used to score 0.0 and get gated out wholesale.
NEWS_RELEVANCE_NAME_MATCH_SCORE=0.6

# --- News materiality signal (the cheap, non-LLM "is this important enough to be worth a
# token?" half of the pre-filter) ---
# Market-moving event terms; the share of these found in an item's title+summary is the
# score's main component. Whole-word, case-insensitive; multi-word entries allowed.
# NEWS_MATERIALITY_KEYWORDS=["acquisition","bankruptcy","central bank","default","downgrade","earnings","fed","guidance","inflation","interest rate","ipo","lawsuit","layoffs","merger","rate cut","rate hike","recession","reform","regulation","sanctions","selloff","stimulus","tariff","upgrade"]
# Publishers whose choosing to cover an event is itself evidence it matters (matched against
# the article's own outlet, case-insensitively).
# NEWS_MATERIALITY_HIGH_IMPACT_SOURCES=["Bloomberg","CNBC","Financial Times","Reuters","The Wall Street Journal","Yahoo Finance"]
# Relative weights of the four materiality components — keyword hits, publisher, |sentiment|,
# and recency (normalized by their sum, so zeroing one out reweights the others).
NEWS_MATERIALITY_KEYWORD_WEIGHT=0.5
NEWS_MATERIALITY_SOURCE_WEIGHT=0.2
NEWS_MATERIALITY_SENTIMENT_WEIGHT=0.15
NEWS_MATERIALITY_RECENCY_WEIGHT=0.15
# Recency decays by half every this many hours since publication.
NEWS_MATERIALITY_RECENCY_HALF_LIFE_HOURS=24.0
# Keyword hits at or above this count saturate the keyword component at 1.0.
NEWS_MATERIALITY_KEYWORD_SATURATION_COUNT=3

# --- Pending news analysis batch pipeline (POST /api/v1/news/analyze-pending + its
# scheduled tick) ---
# Master switch for the SCHEDULED tick only. Set to false to stop the background analysis job
# from being registered at all (no unattended LLM spend); the on-demand
# POST /api/v1/news/analyze-pending and the per-item POST /api/v1/news/{id}/analyze
# ("Analizar ahora") keep working either way.
NEWS_ANALYSIS_ENABLED=true
# Max concurrent LLM classification calls the batch pipeline fans out at once.
NEWS_ANALYSIS_MAX_CONCURRENCY=5
# Max pending news items processed per batch run/tick.
NEWS_ANALYSIS_BATCH_LIMIT=200
# Minutes between scheduled background analysis ticks.
NEWS_ANALYSIS_POLL_INTERVAL_MINUTES=15

# --- News detail payload (issue #57: GET /api/v1/news/{id}) ---
# Max affected instruments given a live price lookup on the detail page (one market-data
# fetch each), so an over-tagged article can't fan out dozens of upstream calls.
NEWS_DETAIL_MAX_AFFECTED_INSTRUMENTS=8
# How many related articles the detail page's "related news" list carries.
NEWS_DETAIL_RELATED_LIMIT=12
# Lookback (days) for the affected-instrument chips' % change.
NEWS_DETAIL_PRICE_WINDOW_DAYS=30

# --- Historical analogs RAG (behind the VectorStore port, pgvector-backed; issue #15) ---
HISTORICAL_ANALOGS_TOP_K=3

# --- Track-5 seed data paths ---
# Leave unset to use the packaged seeds in src/app/infrastructure/seeds/.
# UNIVERSE_SEED_PATH=
# NEWS_FIXTURE_SEED_PATH=
# PRESET_SCENARIOS_SEED_PATH=

# --- Gemini (Event Intelligence / Sentinel analyzer) ---
# Free key at https://aistudio.google.com/apikey. Leave empty to use fallback analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Redis (Upstash, LangGraph checkpointer + cache) ---
# Leave empty to use the in-memory checkpointer fallback (InMemoryCheckpointer).
# Example when set: REDIS_URL=rediss://default:<password>@<host>:6379
# REDIS_URL=

# --- Watchdog / Notifier (scheduled watchlist monitoring + alerts) ---
# Deployed frontend base URL, used to compose an alert's link-back URL.
FRONTEND_BASE_URL=http://localhost:4200
# Scheduled scan cadence in minutes; keep within the 5-15 minute product window.
WATCHDOG_POLL_INTERVAL_MINUTES=10
# Minimum signal confidence (0-1) for the Watchdog to raise an alert.
WATCHDOG_MIN_CONFIDENCE=0.6
# UTC hour/minute the daily scheduled briefing run fires.
WATCHDOG_DAILY_BRIEFING_HOUR_UTC=13
WATCHDOG_DAILY_BRIEFING_MINUTE_UTC=0

# --- Telegram bot (per-user alert delivery, behind the NotificationChannel port, issue #14) ---
# Get a token from @BotFather. Leave empty to keep the LoggingNotificationChannel fallback.
TELEGRAM_BOT_TOKEN=
# Bot's @username (no leading @), used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL Telegram POSTs updates to, e.g. https://your-api.example.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Optional shared secret verified against the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Minutes a generated /start <token> linking token stays valid before it expires unused.
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15

# --- Scenario synthesis resilience (issue #64) ---
# Bounded retry around the Synthesis step's structured-output call before the pipeline
# surfaces an honest "analysis unavailable" state instead of a zero-confidence result.
SCENARIO_SYNTHESIS_MAX_ATTEMPTS=2

# --- Scenario Monitors (arm a saved ScenarioResult as a Watchdog rule, issue #18) ---
# Days an armed monitor stays active before auto-expiring with no match.
SCENARIO_MONITOR_TTL_DAYS=14
# Absolute price-move % (since arming) that counts as a match, per scenario magnitude.
SCENARIO_MONITOR_PRICE_MOVE_THRESHOLD_LOW_PCT=2.0
SCENARIO_MONITOR_PRICE_MOVE_THRESHOLD_MEDIUM_PCT=5.0
SCENARIO_MONITOR_PRICE_MOVE_THRESHOLD_HIGH_PCT=10.0
# Cap (in days) on the "since arming" price-history window requested per evaluation pass.
SCENARIO_MONITOR_PRICE_WINDOW_MAX_DAYS=30

# --- Chart visualizations ---
CHARTS_ENABLED=true
CHART_DEFAULT_TIMEFRAME=1y
# Lists/dicts are JSON-encoded for pydantic-settings:
CHART_AVAILABLE_TIMEFRAMES=["1m","3m","6m","1y","max"]
CHART_TIMEFRAME_DAYS={"1m":30,"3m":90,"6m":180,"1y":365,"max":1825}
CHART_MAX_POINTS=500

# --- Shared asset-analysis caching (issue #29) ---
# Analysis (signals/scenarios/sentiment) is SHARED, not per-user, so one LLM run per
# (instrument, locale) per TTL window is enough. These back the FreshnessPolicy value object.
# Freshness TTL per asset class — how long a persisted analysis counts as current before a
# generate call may spend another LLM run. Crypto moves fastest; DEFAULT covers credit/
# commodity and preset scenarios (which have no single instrument).
ANALYSIS_TTL_CRYPTO_MINUTES=15
ANALYSIS_TTL_EQUITY_MINUTES=360
ANALYSIS_TTL_FX_MINUTES=60
ANALYSIS_TTL_DEFAULT_MINUTES=180
# Rows kept per (instrument_symbol, locale) after each write — a short audit trail that keeps
# signals/scenarios/sentiment_readings from growing without bound.
ANALYSIS_RETENTION_KEEP=5
# Master switch for the SCHEDULED refresh tick only (it is the job that spends tokens
# unattended). Off => POST /api/v1/analysis/refresh and the generate endpoints still work, but
# whoever makes the first request after a TTL expires pays the pipeline latency inline.
ANALYSIS_REFRESH_ENABLED=true
# Cadence of the background tick that keeps watchlisted instruments warm. One tick; the TTLs
# above decide staleness, so this doesn't need to be kept in sync with them.
ANALYSIS_REFRESH_POLL_INTERVAL_MINUTES=5
# Locales kept warm. `locale` is part of the cache key (analysis is localized), so each symbol
# is refreshed once per locale here. JSON-encoded for pydantic-settings:
ANALYSIS_REFRESH_LOCALES=["en","es"]
# Max concurrent generations inside one refresh tick (bounds LLM fan-out).
ANALYSIS_REFRESH_CONCURRENCY=4
