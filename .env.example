# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | staging | production
APP_ENV=development

# Comma-separated list is NOT supported directly by pydantic-settings' default list
# parsing for env vars; provide a JSON array string instead, e.g.:
# CORS_ORIGINS=["http://localhost:4200","https://your-frontend.vercel.app"]
CORS_ORIGINS=["http://localhost:4200"]

# Locale used for LLM-generated content (chat/signals/briefings/scenarios) when neither the
# request nor the authenticated user's `preferred_locale` supplies one, e.g. "en", "es",
# "es-MX". Must match the frontend's default locale (`es`) — see issue #67.
DEFAULT_LOCALE=es

# --- OpenAI (primary LLM provider, behind the LLMProvider port) ---
OPENAI_API_KEY=
# Fast/default tier (issue #28): chat routing, conversation titles, sentiment tone scoring,
# scenario intake extraction, news blurb localization — small structured calls.
OPENAI_MODEL=gpt-4o-mini
# Reasoning tier (issue #28): impact signals, pending-news batch analysis, scenario synthesis,
# causal chains, macro interpretation, watchlist briefings, and the 6 chat specialists.
# LEAVE EMPTY to fall back to OPENAI_MODEL — i.e. unset reproduces today's single-model
# behavior exactly. Set it (e.g. gpt-4o) to raise quality on the analytical calls only.
OPENAI_MODEL_REASONING=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Agent-graph chat model tuning (latency/cost quick wins), applied to every ChatOpenAI built
# for the router + specialists. Per-request timeout (seconds) so one hung OpenAI call can't
# pin a chat turn open forever.
OPENAI_REQUEST_TIMEOUT_SECONDS=60.0
# Automatic retries ChatOpenAI performs on a transient/5xx/timeout failure before giving up.
OPENAI_MAX_RETRIES=2
# Cap on tokens generated per chat-model completion — bounds worst-case reply latency and cost.
# A long multi-specialist answer that exceeds it is silently truncated (finish_reason="length").
CHAT_MAX_OUTPUT_TOKENS=4096
# Temperature for the ROUTER's route classification only (0.0 = as deterministic as allowed).
ROUTER_TEMPERATURE=0.0
# Trailing messages of the thread the router classifies (4 ~= the last 2 exchanges).
ROUTER_HISTORY_MAX_MESSAGES=4
# Trailing messages sent to the specialist/contributor/synthesizer calls (12 ~= last 6 exchanges).
# Bounds per-call prompt growth on long threads; the checkpointed history itself is untouched.
CHAT_HISTORY_MAX_MESSAGES=12
# Total attempts the post-stream background write of a chat turn makes before giving up
# (WARNING logged, turn lost). Spaced retries outlive the brief window an App Runner deploy
# opens; 1 disables retrying entirely.
CHAT_PERSIST_RETRY_MAX_ATTEMPTS=3
# Base seconds between those attempts (linear backoff: attempt * base).
CHAT_PERSIST_RETRY_BACKOFF_SECONDS=2.0

# --- OpenAI Realtime voice agent (ephemeral session mint + server-side tool dispatch) ---
# Master switch; when false the /chat/realtime/* endpoints return 503.
OPENAI_REALTIME_ENABLED=false
# SEPARATE billed Realtime key. MAY be left unset to reuse OPENAI_API_KEY (DI falls back to it).
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=alloy
# TTL (seconds) of a minted ephemeral client secret (ek_*) before it expires.
OPENAI_REALTIME_TTL_SECONDS=600
# Tool-selection mode for the voice session: "auto" (answer directly, call a tool only when
# needed) or "required" (force a tool call every turn — drove a filler/self-response loop).
OPENAI_REALTIME_TOOL_CHOICE=auto
# Sampling temperature for the voice session (applied by the WS transport; the GA mint has no
# temperature field). Lower than text chat to keep spoken replies focused.
OPENAI_REALTIME_TEMPERATURE=0.6
# server_vad turn-detection tuning (both transports): VAD activation threshold (0-1), silence
# (ms) that ends a turn, whether to auto-create a reply at end-of-turn, and whether the user can
# barge in over the model.
OPENAI_REALTIME_VAD_THRESHOLD=0.5
OPENAI_REALTIME_VAD_SILENCE_MS=500
OPENAI_REALTIME_VAD_CREATE_RESPONSE=true
OPENAI_REALTIME_VAD_INTERRUPT_RESPONSE=true

# --- Text-to-Speech (voice playback of assistant replies, behind the TTSProvider port) ---
# Leaving TTS_API_KEY unset disables TTS: chat still works, POST /api/v1/chat/speak
# returns 503, and the frontend falls back to the browser's speech synthesis. Kept as its
# own key (not reusing OPENAI_API_KEY) so TTS can be enabled/billed independently.
TTS_ENABLED=false
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=nova
TTS_RESPONSE_FORMAT=mp3
TTS_MAX_INPUT_CHARS=4096       # Max characters per /speak request; caps per-request TTS cost

# --- Speech-to-Text (dictate a chat message by voice, behind the STTProvider port) ---
# Leaving STT_API_KEY unset disables STT: chat still works, POST /api/v1/chat/transcribe
# returns 503, and the frontend falls back to the browser's speech recognition. Kept as its
# own key (not reusing OPENAI_API_KEY) so STT can be enabled/billed independently.
STT_ENABLED=false
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=whisper-1
STT_MAX_AUDIO_BYTES=26214400   # Max audio bytes per /transcribe request (25 MiB, Whisper cap); leave STT_API_KEY unset to disable

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
# MUST be the service-role (secret) key, NOT the anon/publishable key — this backend
# is architected to bypass RLS by design (see migration 0001's rationale) and writes
# will fail with `42501` RLS violations if a low-privilege key is used instead.
# Dashboard: Project Settings -> API -> "service_role" secret. Never expose this key
# to a browser/frontend context (contrast with the frontend's `supabaseAnonKey`, which
# is correctly the LOW-privilege anon key).
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
# Retry-with-backoff around every Supabase*Repository client call (issue #7): only
# transient network failures (DNS blips, dropped connections) are retried, never
# application-level Postgrest errors (RLS violations, constraint errors, etc).
SUPABASE_RETRY_MAX_ATTEMPTS=2
SUPABASE_RETRY_BACKOFF_BASE_SECONDS=0.2

# --- Database (Supabase Postgres connection string, used by the pgvector adapter) ---
# Use the Supavisor SESSION POOLER connection string, NOT the direct connection
# (issue #35): the direct host `db.<project-ref>.supabase.co` resolves to IPv6 only and
# fails on IPv4-only networks (App Runner, most CI, many local setups). The session
# pooler is dual-stack and reachable over IPv4. Copy it from the Supabase dashboard:
# Project Settings -> Database -> Connection string -> "Session pooler". Its shape is
# `postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres`
# (host `aws-0-<region>.pooler.supabase.com`, user `postgres.<project-ref>`).
DATABASE_URL=

# --- Marketaux (news + entity sentiment enrichment, behind the NewsProvider port) ---
# Free key at https://www.marketaux.com/register (no billing details required).
# Leave empty to disable this source (the adapter then returns no items).
MARKETAUX_API_KEY=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
# Comma-separated article languages, e.g. en,es
MARKETAUX_LANGUAGES=en
MARKETAUX_TIMEOUT_SECONDS=10.0
# Pages fetched per call (free plan: 3 articles/request, 100 requests/day)
MARKETAUX_MAX_PAGES=3
# Circuit breaker (issue #9): after a 402/401 (quota exhausted/unauthorized), stop
# calling Marketaux for this many minutes instead of retrying every poll.
MARKETAUX_COOLDOWN_MINUTES=20
# Shorter cool-down used after a 429 (rate-limited) — likely to clear sooner.
MARKETAUX_RATE_LIMIT_COOLDOWN_MINUTES=5

# --- NewsAPI.org (news, behind the NewsProvider port) ---
# Free key at https://newsapi.org/register. Leave empty to skip this source.
NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2
# Query used when no instrument symbols are requested (general market news).
NEWSAPI_DEFAULT_QUERY=stocks OR crypto OR markets
# Circuit breaker: after a 401/426 (key/quota/plan issue) stop calling NewsAPI for this
# many minutes; a 429 (rate-limited) uses the shorter cool-down below (clears sooner).
NEWSAPI_COOLDOWN_MINUTES=20
NEWSAPI_RATE_LIMIT_COOLDOWN_MINUTES=5

# --- Finnhub (company-news, behind the NewsProvider port) ---
# Free key at https://finnhub.io/register. Leave empty to skip this source.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# --- RSS feeds (behind the NewsProvider port); no key required ---
# JSON array string, same convention as CORS_ORIGINS above.
RSS_FEED_URLS=["https://www.coindesk.com/arc/outboundfeeds/rss/","https://finance.yahoo.com/news/rssindex"]
RSS_FEED_TIMEOUT_SECONDS=10.0

# --- GET /api/v1/news read path (taws#71) ---
# Serve the feed from the persisted `news_items` store instead of re-aggregating the
# upstream providers synchronously on the request path. Set to false to restore the old
# always-blocking behavior.
NEWS_DB_FIRST_ENABLED=true
# Persisted items a window must yield before it is served straight from the store; below
# this the store counts as cold and the request falls back to a blocking upstream fetch.
NEWS_DB_FIRST_MIN_ITEMS=1
# Cadence (seconds) of the post-response upstream refresh that keeps `news_items` warm,
# per (symbol, asset_class, since_hours).
NEWS_REFRESH_MIN_INTERVAL_SECONDS=120.0
# Items requested from the upstream providers per background refresh run.
NEWS_REFRESH_LIMIT=50

# --- CoinGecko (crypto prices, behind the MarketDataProvider port) ---
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Short-TTL in-process cache in front of get_price_series/get_last_price (issue #8),
# keyed by (coin_id, days)/coin_id — cuts redundant calls against the free-tier rate limit.
COINGECKO_CACHE_TTL_SECONDS=60.0
# SET THIS. Free "Demo" key: https://www.coingecko.com/en/api/pricing -> Demo plan.
# The API technically works keyless, which is exactly why this was left empty and why crypto
# prices were broken for so long without anyone noticing: keyless, the public tier 429s after
# roughly three calls, which tripped the circuit breaker below, which used to serve SYNTHETIC
# prices. (That is how BTC got charted to a user at $333.6.) The fixtures are gone now, so
# leaving this empty no longer fabricates data — it just makes crypto prices unavailable a lot.
#
# Accepts a COMMA-SEPARATED LIST of keys for failover: `CG-aaa,CG-bbb`. The Demo quota
# (~30 calls/min, 10k/month) is metered PER KEY and is shared by all three CoinGecko adapters
# (prices + /coins/markets metadata + /search), so one key runs out fast. When a key gets
# rate-limited, it is benched for COINGECKO_KEY_COOLDOWN_SECONDS and the same request is
# retried immediately on the next key. CoinGecko issues one Demo key per account, so a second
# key means a second CoinGecko account.
COINGECKO_API_KEY=
# How long a rate-limited (429) key is benched before the ring tries it again. The Demo limit
# is PER MINUTE, so ~60s is all a throttled key needs to recover.
COINGECKO_KEY_COOLDOWN_SECONDS=60.0
# Circuit-breaker backoff (seconds): after CoinGecko goes DOWN (5xx / unreachable), stop calling
# it for this long instead of re-hitting it on every poll. Crypto prices are reported as
# UNAVAILABLE during the backoff. A 4xx from a bad request does NOT trip it — and neither does a
# 429, which is the key ring's job (bench that key, fail over), not this breaker's.
COINGECKO_COOLDOWN_SECONDS=300.0
# Longest history the public/Demo tiers will serve; requests are clamped to it. Beyond this
# CoinGecko returns error 10012, and that 400 used to trip the breaker above — so one click on
# the chart's "max" button (1825 days) poisoned every crypto price for the next 5 minutes.
COINGECKO_MAX_HISTORY_DAYS=365

# --- yfinance (stocks/FX/commodities/credit ETFs, behind the MarketDataProvider port); no key
# required ---
# Short-TTL in-process cache in front of get_price_series/get_last_price (mirrors the CoinGecko
# cache), keyed by (ticker, days)/ticker — cuts redundant live Yahoo round-trips when the radar
# polls the same instruments every ~60s. Only non-empty results are cached, so a transient blank
# never pins an instrument as unavailable for the window.
YFINANCE_CACHE_TTL_SECONDS=120.0

# --- FRED (macro: rates, CPI; behind the MacroDataProvider port) ---
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html.
# Leave empty to serve fixture rates/CPI instead (no crash).
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_RATES_SERIES_ID=FEDFUNDS
FRED_CPI_SERIES_ID=CPIAUCSL
# Extra "Contexto de mercado" indicators (issue #58): daily FRED series (WTI oil USD/bbl,
# 10Y Treasury constant-maturity yield %).
FRED_OIL_SERIES_ID=DCOILWTICO
FRED_TREASURY_10Y_SERIES_ID=DGS10
# DEPRECATED — unused. FRED's free daily gold fixing (GOLDPMGBD228NLBM) was discontinued and
# 503'd; gold now comes from yfinance GC=F (see YFINANCE_GOLD_SYMBOL below). Left only so a
# deployed .env that still sets it doesn't error on load.
FRED_GOLD_SERIES_ID=GOLDPMGBD228NLBM
FRED_TIMEOUT_SECONDS=10.0
# Short-TTL in-process cache in front of get_rates/get_cpi/get_volatility_regime (mirrors the
# CoinGecko cache). Longer default than the price caches — rates/CPI update monthly, VIX daily —
# but every macro-aware pipeline re-reads them per request. Only successful reads are cached.
FRED_CACHE_TTL_SECONDS=1800.0
# History window (observations) for GET /api/v1/macro/series/{indicator}.
MACRO_SERIES_DEFAULT_DAYS=90
MACRO_SERIES_MAX_DAYS=365

# --- Gold "Contexto de mercado" series (MacroDataProvider port); via yfinance, no key needed ---
# COMEX gold futures continuous front-month, replacing the discontinued FRED gold fixing.
YFINANCE_GOLD_SYMBOL=GC=F

# --- VIX (volatility regime, behind the MacroDataProvider port); via yfinance, no key needed ---
VIX_SYMBOL=^VIX
VIX_LOW_THRESHOLD=15.0
VIX_ELEVATED_THRESHOLD=20.0
VIX_HIGH_THRESHOLD=30.0

# NOTE: FIXTURE_MACRO_* (rate 5.25, CPI 3.2, VIX 18.5, ...) and FIXTURE_FEAR_GREED_* used to
# live here as fallbacks for when a live call failed. They are gone on purpose, along with every
# other synthetic data source. A config default for a *market observation* is a fabrication with
# a settings key: each of those was a plausible-looking number that got served, believed, and
# narrated to users as measured fact whenever the real provider hiccuped. Do not add more.

# --- alternative.me (Crypto Fear & Greed Index, behind the FearGreedProvider port); no key
# required. Free public API: https://alternative.me/crypto/fear-and-greed-index/ ---
ALTERNATIVE_ME_BASE_URL=https://api.alternative.me
ALTERNATIVE_ME_TIMEOUT_SECONDS=10.0
# Short-TTL in-process cache in front of get_fear_greed_index (mirrors the CoinGecko cache). The
# index only updates ~once a day, so this is the longest of the three caches; only a successful
# read is cached, so an outage still surfaces as FearGreedUnavailableError, never a stale value.
FEAR_GREED_CACHE_TTL_SECONDS=3600.0

# --- Sentiment Analyst tone bucketing thresholds (tone_score -> SentimentLabel) ---
SENTIMENT_BULLISH_THRESHOLD=0.15
SENTIMENT_BEARISH_THRESHOLD=-0.15

# --- SEC EDGAR "latest filings" feed (behind the NewsProvider port); no key required, but
# SEC requires a descriptive User-Agent identifying the requester on every request
# (https://www.sec.gov/os/webmaster-faq#developers) — replace with a real app/company name
# + contact email before deploying publicly. Set SEC_EDGAR_ENABLED=false to disable this
# source without removing the URL(s) below. ---
SEC_EDGAR_ENABLED=true
SEC_EDGAR_USER_AGENT=TAWS Hackathon research@taws.dev
# JSON array string, same convention as CORS_ORIGINS/RSS_FEED_URLS above.
SEC_EDGAR_FEED_URLS=["https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&type=8-K&company=&dateb=&owner=include&count=100&output=atom"]
SEC_EDGAR_FEED_TIMEOUT_SECONDS=10.0

# --- Fundamentals / earnings calendar (behind the FundamentalsProvider port); yfinance, no
# key required. "Upcoming earnings risk" flags earnings dates within this many days of now.
UPCOMING_EARNINGS_RISK_WINDOW_DAYS=7

# --- Analyst signal generation (HU1 acceptance criterion: "≥2 news sources with source +
# date attached to each signal") ---
MIN_DISTINCT_NEWS_SOURCES=2

# Bounded retry around the Analyst's structured-output classification call before it
# degrades to an honest "uncertain, analysis unavailable" fallback. Retries transient
# failures only (rate limit / timeout / malformed structured output); a missing API key
# is not retried. MAX_ATTEMPTS counts retries after the first try (2 => up to 3 calls);
# backoff is exponential (base * 2**(attempt-1)).
SIGNAL_CLASSIFICATION_RETRY_MAX_ATTEMPTS=2
SIGNAL_CLASSIFICATION_RETRY_BACKOFF_BASE_SECONDS=0.5

# --- Pending news pre-filter (skip unimportant items without an LLM call) ---
# Floor (0-1) below which a pending news item is skipped without an LLM call
# (analysis_status -> skipped, skip_reason -> gated_low_relevance). This gates the COMBINED
# relevance + materiality score below, not symbol-relevance alone.
NEWS_RELEVANCE_SKIP_THRESHOLD=0.35
# How the two components of that combined score are weighted (normalized by their sum, so
# only the ratio matters). Materiality is what lets a genuinely important article that never
# spells out a watchlist ticker still clear the gate.
NEWS_PREFILTER_RELEVANCE_WEIGHT=0.6
NEWS_PREFILTER_MATERIALITY_WEIGHT=0.4
# Relevance credited when an article is linked to an instrument by company/fund NAME rather
# than by its ticker ("Apple unveils..." -> AAPL). Weaker evidence than an explicit ticker,
# hence < 1.0 — but these used to score 0.0 and get gated out wholesale.
NEWS_RELEVANCE_NAME_MATCH_SCORE=0.6

# --- News materiality signal (the cheap, non-LLM "is this important enough to be worth a
# token?" half of the pre-filter) ---
# Market-moving event terms; the share of these found in an item's title+summary is the
# score's main component. Whole-word, case-insensitive; multi-word entries allowed.
# NEWS_MATERIALITY_KEYWORDS=["acquisition","bankruptcy","central bank","default","downgrade","earnings","fed","guidance","inflation","interest rate","ipo","lawsuit","layoffs","merger","rate cut","rate hike","recession","reform","regulation","sanctions","selloff","stimulus","tariff","upgrade"]
# Publishers whose choosing to cover an event is itself evidence it matters (matched against
# the article's own outlet, case-insensitively).
# NEWS_MATERIALITY_HIGH_IMPACT_SOURCES=["Bloomberg","CNBC","Financial Times","Reuters","The Wall Street Journal","Yahoo Finance"]
# Relative weights of the four materiality components — keyword hits, publisher, |sentiment|,
# and recency (normalized by their sum, so zeroing one out reweights the others).
NEWS_MATERIALITY_KEYWORD_WEIGHT=0.5
NEWS_MATERIALITY_SOURCE_WEIGHT=0.2
NEWS_MATERIALITY_SENTIMENT_WEIGHT=0.15
NEWS_MATERIALITY_RECENCY_WEIGHT=0.15
# Recency decays by half every this many hours since publication.
NEWS_MATERIALITY_RECENCY_HALF_LIFE_HOURS=24.0
# Keyword hits at or above this count saturate the keyword component at 1.0.
NEWS_MATERIALITY_KEYWORD_SATURATION_COUNT=3

# --- Pending news analysis batch pipeline (POST /api/v1/news/analyze-pending + its
# scheduled tick) ---
# Master switch for the SCHEDULED tick only. Set to false to stop the background analysis job
# from being registered at all (no unattended LLM spend); the on-demand
# POST /api/v1/news/analyze-pending and the per-item POST /api/v1/news/{id}/analyze
# ("Analizar ahora") keep working either way.
NEWS_ANALYSIS_ENABLED=true
# Max concurrent LLM classification calls the batch pipeline fans out at once.
NEWS_ANALYSIS_MAX_CONCURRENCY=5
# Max pending news items processed per batch run/tick.
NEWS_ANALYSIS_BATCH_LIMIT=200
# Minutes between scheduled background analysis ticks.
NEWS_ANALYSIS_POLL_INTERVAL_MINUTES=15

# --- Per-article news sentiment (fills news_items.sentiment_score) ---
# The UI's Positivo/Negativo/Neutral badge and filter read `sentiment_score`. Before this job
# existed, the ONLY producer of that column was a pass-through of Marketaux's own number, so
# every article from SEC EDGAR / RSS / NewsAPI / Finnhub stayed NULL and rendered as
# "Sin clasificar". Not to be confused with the per-INSTRUMENT tone reading (AnalyzeSentiment →
# `sentiment_readings`), which answers "how is coverage of AAPL?" rather than "is this article
# good or bad news?". Master switch for the scheduled tick only.
NEWS_SENTIMENT_ENABLED=true
# Cadence of the scoring tick. Also the backfill rate — the pass scores unscored rows
# newest-first, so the existing NULL backlog drains at BATCH_LIMIT per tick.
NEWS_SENTIMENT_POLL_INTERVAL_MINUTES=10
# Max articles pulled per tick (bounds unattended LLM spend; also how fast the archive drains).
NEWS_SENTIMENT_BATCH_LIMIT=60
# Articles scored per LLM call. Batched because headlines are short and independent, which keeps
# the cost proportional to the work rather than to the size of the archive. Above ~15 the model
# starts dropping entries from its response.
NEWS_SENTIMENT_CHUNK_SIZE=15

# --- News detail payload (issue #57: GET /api/v1/news/{id}) ---
# Max affected instruments given a live price lookup on the detail page (one market-data
# fetch each), so an over-tagged article can't fan out dozens of upstream calls.
NEWS_DETAIL_MAX_AFFECTED_INSTRUMENTS=8
# How many related articles the detail page's "related news" list carries.
NEWS_DETAIL_RELATED_LIMIT=12
# Lookback (days) for the affected-instrument chips' % change.
NEWS_DETAIL_PRICE_WINDOW_DAYS=30

# --- News browse page (issue #70): GET /api/v1/news/browse, the DB-backed archive with
# numbered pagination. Distinct from the live provider-fed GET /api/v1/news. ---
# Page size used when the caller doesn't pass one, and the ceiling it's clamped to.
NEWS_BROWSE_DEFAULT_PAGE_SIZE=20
NEWS_BROWSE_MAX_PAGE_SIZE=100
# abs(sentiment_score) at or below which an item counts as neutral in the browse sentiment
# filter. Must match the frontend's classifyNewsSentiment threshold, or a card badged
# "positivo" could fall outside the "positive" filter.
NEWS_SENTIMENT_NEUTRAL_THRESHOLD=0.15

# --- Historical analogs RAG (behind the VectorStore port, pgvector-backed; issue #15) ---
HISTORICAL_ANALOGS_TOP_K=3

# --- Track-5 seed data paths ---
# Leave unset to use the packaged seeds in src/app/infrastructure/seeds/. These seed
# CONFIGURATION (which instruments exist, which scenarios are offered) — never market
# observations. NEWS_FIXTURE_SEED_PATH is gone: canned articles are not news.
# UNIVERSE_SEED_PATH=
# PRESET_SCENARIOS_SEED_PATH=

# --- Gemini (Event Intelligence / Sentinel analyzer) ---
# Free key at https://aistudio.google.com/apikey. Leave empty to use fallback analysis.
GEMINI_API_KEY=
# Current fast model for Sentinel's financial relevance decisions.
GEMINI_MODEL=gemini-3.5-flash

# --- Sentinel automatic news alerts (poll real news -> Gemini -> important? -> Telegram) ---
# The scheduled job that replaces the manual "send a news analysis to Telegram" button: it
# polls the live news providers, has Gemini judge each article's importance, and broadcasts the
# ones that clear BOTH gates below to every chat linked via the /start deep link.
# Master switch for the SCHEDULED scan only. Off => nothing is broadcast automatically, but
# POST /event-intelligence/demo and POST /telegram/send-test-news keep working on demand. It's
# behind a switch because it spends Gemini tokens AND pushes notifications unattended.
SENTINEL_ALERTS_ENABLED=true
# Minutes between scheduled scans.
SENTINEL_POLL_INTERVAL_MINUTES=15
# How far back each scan looks. Keep it comfortably above the poll interval so a brief outage
# can't skip a window; the overlap is free (already-analyzed items are filtered before any LLM
# call, so they are never re-billed and never re-sent).
SENTINEL_NEWS_SINCE_HOURS=6
# Articles pulled per scan, before the already-seen filter.
SENTINEL_NEWS_FETCH_LIMIT=30
# Gemini importance floor (0-1) an article must clear IN ADDITION to the model's own
# `shouldNotify` boolean. Raise it to make the bot more selective; lower it to be chattier.
SENTINEL_IMPORTANCE_THRESHOLD=0.7
# High-importance floor (0-1) that ROUTES an already-important event to a market-wide broadcast
# instead of watchlist-targeted delivery. An event clearing SENTINEL_IMPORTANCE_THRESHOLD but
# scoring BELOW this floor reaches only users whose watchlist holds one of its affected assets;
# at or above it, the event is broadcast to every linked chat. Must be >=
# SENTINEL_IMPORTANCE_THRESHOLD.
SENTINEL_BROADCAST_IMPORTANCE_THRESHOLD=0.90
# Hard cap on alerts per scan, applied after sorting by importance (so the most important
# survive). Stops a chaotic news morning from carpet-bombing every user's phone.
SENTINEL_MAX_ALERTS_PER_RUN=3
# Max concurrent Gemini analysis calls within one scan.
SENTINEL_MAX_CONCURRENCY=3
# Relevance pre-gate (cheap, no-AI) applied BEFORE any Gemini call, so tokens are only spent on
# articles that plausibly matter. Track 1 (watchlist): the article's title+description mentions a
# symbol or canonical company name on the union of ALL users' watchlists. Track 2 (macro): the
# text hits one of these keywords. Whole-word/phrase, case-insensitive. JSON array string, same
# convention as CORS_ORIGINS/RSS_FEED_URLS above. Empty [] disables the macro track.
# SENTINEL_MACRO_KEYWORDS=["Federal Reserve","Fed","interest rate","rate cut","rate hike","inflation","CPI","PCE","recession","GDP","unemployment","jobs report","OPEC","crude oil","Treasury","bond yields","tariff"]
# Shortest tracked-symbol length matched as a BARE ticker (1-2 char tickers like "A"/"IT" collide
# with common words even whole-word-matched, so they match only via their canonical company name).
SENTINEL_MIN_SYMBOL_MATCH_LENGTH=3

# --- Redis (Upstash, LangGraph checkpointer + cache) ---
# REQUIRED unless APP_ENV=development. Leaving it empty in any other environment now raises
# at startup instead of silently falling back to InMemoryCheckpointer: that fallback put the
# agent's memory of a conversation in one worker's RAM, so it died on restart and differed
# per replica. With APP_ENV=development, an empty value still falls back (with a warning).
# Note this is the agent's WORKING MEMORY, not the transcript — chat history itself is stored
# durably in Postgres (`conversations`, migration 0020) regardless of Redis.
# Example when set: REDIS_URL=rediss://default:<password>@<host>:6379
# REDIS_URL=

# --- Watchdog / Notifier (scheduled watchlist monitoring + alerts) ---
# Deployed frontend base URL, used to compose an alert's link-back URL.
FRONTEND_BASE_URL=http://localhost:4200
# Scheduled scan cadence in minutes; keep within the 5-15 minute product window.
WATCHDOG_POLL_INTERVAL_MINUTES=10
# Minimum signal confidence (0-1) for the Watchdog to raise an alert.
WATCHDOG_MIN_CONFIDENCE=0.6
# Quiet period before the SAME instrument may alert again with the SAME direction. A signal
# that CHANGES direction (e.g. positive -> negative) always alerts immediately, regardless of
# this. Guards against the analysis-refresh job (which mints a fresh signal row for every
# watchlisted instrument every few minutes) re-alerting the same ticker on every scan.
WATCHDOG_ALERT_COOLDOWN_MINUTES=360
# UTC hour/minute the daily scheduled briefing run fires.
WATCHDOG_DAILY_BRIEFING_HOUR_UTC=13
WATCHDOG_DAILY_BRIEFING_MINUTE_UTC=0

# --- Telegram bot (per-user alert delivery, behind the NotificationChannel port, issue #14) ---
# Get a token from @BotFather. REQUIRED unless APP_ENV=development: Telegram is the only
# outbound channel, so an empty token used to mean every Watchdog alert, briefing notice,
# scenario match and Sentinel broadcast was composed, logged, and silently dropped while the
# scheduler still reported success. Empty now raises outside development; with
# APP_ENV=development it still falls back to LoggingNotificationChannel (with a warning).
TELEGRAM_BOT_TOKEN=
# Bot's @username (no leading @), used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL Telegram POSTs updates to, e.g. https://your-api.example.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Optional shared secret verified against the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Minutes a generated /start <token> linking token stays valid before it expires unused.
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15

# --- Scenario synthesis resilience (issue #64) ---
# Bounded retry around the Synthesis step's structured-output call before the pipeline
# surfaces an honest "analysis unavailable" state instead of a zero-confidence result.
SCENARIO_SYNTHESIS_MAX_ATTEMPTS=2

# --- Scenario Monitors (arm a saved ScenarioResult as a Watchdog rule, issue #18) ---
# Days an armed monitor stays active before auto-expiring with no match.
SCENARIO_MONITOR_TTL_DAYS=14
# Absolute price-move % (since arming) that counts as a match, per scenario magnitude.
SCENARIO_MONITOR_PRICE_MOVE_THRESHOLD_LOW_PCT=2.0
SCENARIO_MONITOR_PRICE_MOVE_THRESHOLD_MEDIUM_PCT=5.0
SCENARIO_MONITOR_PRICE_MOVE_THRESHOLD_HIGH_PCT=10.0
# Cap (in days) on the "since arming" price-history window requested per evaluation pass.
SCENARIO_MONITOR_PRICE_WINDOW_MAX_DAYS=30

# --- Chart visualizations ---
CHARTS_ENABLED=true
CHART_DEFAULT_TIMEFRAME=1y
# Lists/dicts are JSON-encoded for pydantic-settings:
CHART_AVAILABLE_TIMEFRAMES=["1m","3m","6m","1y","max"]
CHART_TIMEFRAME_DAYS={"1m":30,"3m":90,"6m":180,"1y":365,"max":1825}
CHART_MAX_POINTS=500
# Real data-source vendor labels stamped into ChartMeta.source (crypto -> CoinGecko,
# everything else -> Yahoo Finance). Shown as "Source: {…}" on charts.
MARKET_SOURCE_CRYPTO=CoinGecko
MARKET_SOURCE_EQUITY=Yahoo Finance
# Server-side chart PNG rendering (Telegram sendPhoto). figsize(inches) = px / dpi.
CHART_IMAGE_WIDTH_PX=1000
CHART_IMAGE_HEIGHT_PX=600
CHART_IMAGE_DPI=100
# On-brand dark/gold theme for rendered chart PNGs (hex colors).
CHART_IMAGE_BACKGROUND_COLOR=#0e1116
CHART_IMAGE_TEXT_COLOR=#e6e6e6
CHART_IMAGE_GRID_COLOR=#2a2f3a
CHART_IMAGE_ACCENT_COLOR=#d4af37
CHART_IMAGE_UP_COLOR=#16c784
CHART_IMAGE_DOWN_COLOR=#ea3943

# --- Shared asset-analysis caching (issue #29) ---
# Analysis (signals/scenarios/sentiment) is SHARED, not per-user, so one LLM run per
# (instrument, locale) per TTL window is enough. These back the FreshnessPolicy value object.
# Freshness TTL per asset class — how long a persisted analysis counts as current before a
# generate call may spend another LLM run. Crypto moves fastest; DEFAULT covers credit/
# commodity and preset scenarios (which have no single instrument).
ANALYSIS_TTL_CRYPTO_MINUTES=15
ANALYSIS_TTL_EQUITY_MINUTES=360
ANALYSIS_TTL_FX_MINUTES=60
ANALYSIS_TTL_DEFAULT_MINUTES=180
# Rows kept per (instrument_symbol, locale) after each write — a short audit trail that keeps
# signals/scenarios/sentiment_readings from growing without bound.
ANALYSIS_RETENTION_KEEP=5
# Master switch for the SCHEDULED refresh tick only (it is the job that spends tokens
# unattended). Off => POST /api/v1/analysis/refresh and the generate endpoints still work, but
# whoever makes the first request after a TTL expires pays the pipeline latency inline.
ANALYSIS_REFRESH_ENABLED=true
# Cadence of the background tick that keeps watchlisted instruments warm. One tick; the TTLs
# above decide staleness, so this doesn't need to be kept in sync with them.
ANALYSIS_REFRESH_POLL_INTERVAL_MINUTES=5
# Locales kept warm. `locale` is part of the cache key (analysis is localized), so each symbol
# is refreshed once per locale here. JSON-encoded for pydantic-settings:
ANALYSIS_REFRESH_LOCALES=["en","es"]
# Max concurrent generations inside one refresh tick (bounds LLM fan-out).
ANALYSIS_REFRESH_CONCURRENCY=4
# Whether the tick also covers the whole curated universe, not just watchlisted instruments.
# Off, the markets explorer lists every instrument but only ever shows a signal for the
# watchlisted few — everything else renders "Sin señal" forever, however much news breaks,
# because no producer ever hands it to the classifier. The tick is freshness-gated, so the
# wider scope mostly costs indexed SELECTs, not LLM runs.
ANALYSIS_REFRESH_COVER_UNIVERSE=true
# Hard ceiling on symbols per tick, so growing the universe can't silently grow the unattended
# LLM bill. Watchlisted instruments are always taken first, so the cap can never starve one a
# user actually pinned.
ANALYSIS_REFRESH_MAX_SYMBOLS=40
