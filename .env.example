# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | staging | production
APP_ENV=development

# Comma-separated list is NOT supported directly by pydantic-settings' default list
# parsing for env vars; provide a JSON array string instead, e.g.:
# CORS_ORIGINS=["http://localhost:4200","https://your-frontend.vercel.app"]
CORS_ORIGINS=["http://localhost:4200"]

# --- OpenAI (primary LLM provider, behind the LLMProvider port) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# --- Database (Supabase Postgres connection string, used by the pgvector adapter) ---
DATABASE_URL=

# --- Marketaux (news + entity sentiment enrichment, behind the NewsProvider port) ---
# Free key at https://www.marketaux.com/register (no billing details required).
# Leave empty to disable this source (the adapter then returns no items).
MARKETAUX_API_KEY=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
# Comma-separated article languages, e.g. en,es
MARKETAUX_LANGUAGES=en
MARKETAUX_TIMEOUT_SECONDS=10.0
# Pages fetched per call (free plan: 3 articles/request, 100 requests/day)
MARKETAUX_MAX_PAGES=3

# --- NewsAPI.org (news, behind the NewsProvider port) ---
# Free key at https://newsapi.org/register. Leave empty to skip this source.
NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2
# Query used when no instrument symbols are requested (general market news).
NEWSAPI_DEFAULT_QUERY=stocks OR crypto OR markets

# --- Finnhub (company-news, behind the NewsProvider port) ---
# Free key at https://finnhub.io/register. Leave empty to skip this source.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# --- RSS feeds (behind the NewsProvider port); no key required ---
# JSON array string, same convention as CORS_ORIGINS above.
RSS_FEED_URLS=["https://www.coindesk.com/arc/outboundfeeds/rss/","https://finance.yahoo.com/news/rssindex"]

# --- CoinGecko (crypto prices, behind the MarketDataProvider port); no key required ---
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- FRED (macro: rates, CPI; behind the MacroDataProvider port) ---
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html.
# Leave empty to serve fixture rates/CPI instead (no crash).
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_RATES_SERIES_ID=FEDFUNDS
FRED_CPI_SERIES_ID=CPIAUCSL
FRED_TIMEOUT_SECONDS=10.0

# --- VIX (volatility regime, behind the MacroDataProvider port); via yfinance, no key needed ---
VIX_SYMBOL=^VIX
VIX_LOW_THRESHOLD=15.0
VIX_ELEVATED_THRESHOLD=20.0
VIX_HIGH_THRESHOLD=30.0

# --- Fixture macro fallback values (used when FRED_API_KEY is unset or a live call fails) ---
FIXTURE_MACRO_RATE=5.25
FIXTURE_MACRO_CPI=3.2
FIXTURE_MACRO_VIX=18.5

# --- alternative.me (Crypto Fear & Greed Index, behind the FearGreedProvider port); no key
# required. Free public API: https://alternative.me/crypto/fear-and-greed-index/ ---
ALTERNATIVE_ME_BASE_URL=https://api.alternative.me
ALTERNATIVE_ME_TIMEOUT_SECONDS=10.0

# --- Fixture Fear & Greed fallback values (used when alternative.me is unreachable) ---
FIXTURE_FEAR_GREED_VALUE=50
FIXTURE_FEAR_GREED_CLASSIFICATION=Neutral

# --- Sentiment Analyst tone bucketing thresholds (tone_score -> SentimentLabel) ---
SENTIMENT_BULLISH_THRESHOLD=0.15
SENTIMENT_BEARISH_THRESHOLD=-0.15

# --- SEC EDGAR "latest filings" feed (behind the NewsProvider port); no key required, but
# SEC requires a descriptive User-Agent identifying the requester on every request
# (https://www.sec.gov/os/webmaster-faq#developers) — replace with a real app/company name
# + contact email before deploying publicly. Set SEC_EDGAR_ENABLED=false to disable this
# source without removing the URL(s) below. ---
SEC_EDGAR_ENABLED=true
SEC_EDGAR_USER_AGENT=TAWS Hackathon research@taws.dev
# JSON array string, same convention as CORS_ORIGINS/RSS_FEED_URLS above.
SEC_EDGAR_FEED_URLS=["https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&type=8-K&company=&dateb=&owner=include&count=100&output=atom"]

# --- Fundamentals / earnings calendar (behind the FundamentalsProvider port); yfinance, no
# key required. "Upcoming earnings risk" flags earnings dates within this many days of now.
UPCOMING_EARNINGS_RISK_WINDOW_DAYS=7

# --- Historical analogs RAG (behind the VectorStore port, pgvector-backed; issue #15) ---
HISTORICAL_ANALOGS_TOP_K=3

# --- Track-5 seed data paths ---
# Leave unset to use the packaged seeds in src/app/infrastructure/seeds/.
# UNIVERSE_SEED_PATH=
# NEWS_FIXTURE_SEED_PATH=
# PRESET_SCENARIOS_SEED_PATH=

# --- Redis (Upstash, LangGraph checkpointer + cache) ---
# Leave empty to use the in-memory checkpointer fallback (InMemoryCheckpointer).
# Example when set: REDIS_URL=rediss://default:<password>@<host>:6379
# REDIS_URL=

# --- Watchdog / Notifier (scheduled watchlist monitoring + alerts) ---
# Deployed frontend base URL, used to compose an alert's link-back URL.
FRONTEND_BASE_URL=http://localhost:4200
# Scheduled scan cadence in minutes; keep within the 5-15 minute product window.
WATCHDOG_POLL_INTERVAL_MINUTES=10
# Minimum signal confidence (0-1) for the Watchdog to raise an alert.
WATCHDOG_MIN_CONFIDENCE=0.6
# UTC hour/minute the daily scheduled briefing run fires.
WATCHDOG_DAILY_BRIEFING_HOUR_UTC=13
WATCHDOG_DAILY_BRIEFING_MINUTE_UTC=0

# --- Telegram bot (per-user alert delivery, behind the NotificationChannel port, issue #14) ---
# Get a token from @BotFather. Leave empty to keep the LoggingNotificationChannel fallback.
TELEGRAM_BOT_TOKEN=
# Bot's @username (no leading @), used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL Telegram POSTs updates to, e.g. https://your-api.example.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Optional shared secret verified against the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Minutes a generated /start <token> linking token stays valid before it expires unused.
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
